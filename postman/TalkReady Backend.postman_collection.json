{
  "info": {
    "name": "TalkReady Backend",
    "description": "Auth, notes, sessions, answers, chat, and admin examples. Regular-user /api/v1/notes requests are included as Phase B3 placeholders; that router is not mounted in the current server checkout. Set baseUrl, token, adminToken, noteSetId, sessionId, questionId, chatSessionId, and userId before use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "noteSetId", "value": "000000000000000000000000" },
    { "key": "sessionId", "value": "000000000000000000000000" },
    { "key": "questionId", "value": "000000000000000000000000" },
    { "key": "chatSessionId", "value": "000000000000000000000000" },
    { "key": "userId", "value": "000000000000000000000000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sam\",\n  \"email\": \"sam@example.com\",\n  \"password\": \"Study1234\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().data.accessToken);"] } }] },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"sam@example.com\",\n  \"password\": \"Study1234\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().data.accessToken);"] } }] },
        { "name": "Refresh", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/refresh", "description": "Uses the HttpOnly refreshToken cookie saved by Postman." } },
        { "name": "Current user", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/auth/me" } }
      ]
    },
    {
      "name": "Notes (Phase B3 placeholders)",
      "description": "These normal-user routes are not currently mounted; admin prebuilt notes are available in the Admin folder.",
      "item": [
        { "name": "List own and published notes", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/notes?page=1&limit=20" } },
        { "name": "Create note from text", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"My notes\",\n  \"text\": \"A stack is a last in, first out data structure.\",\n  \"language\": \"en\",\n  \"level\": \"beginner\"\n}" }, "url": "{{baseUrl}}/api/v1/notes" } },
        { "name": "Upload note", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/v1/notes/upload" } },
        { "name": "Get note", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/notes/{{noteSetId}}" } },
        { "name": "Delete note", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/notes/{{noteSetId}}" } }
      ]
    },
    {
      "name": "Sessions and answers",
      "item": [
        { "name": "Create session", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"noteSetIds\": [\"{{noteSetId}}\"],\n  \"style\": \"friendly_coach\",\n  \"mode\": \"practice\",\n  \"language\": \"en\",\n  \"questionCount\": 5\n}" }, "url": "{{baseUrl}}/api/v1/sessions" } },
        { "name": "Next question", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/next-question" } },
        { "name": "Submit answer", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"transcript\": \"A stack is a last in, first out structure. For example, undo history uses a stack.\",\n  \"durationSec\": 35,\n  \"confidence\": 0.8,\n  \"longPauseCount\": 0\n}" }, "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/answers" } },
        { "name": "Session report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/report" } },
        { "name": "Finish session", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/sessions/{{sessionId}}/finish" } },
        { "name": "Progress", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/progress" } }
      ]
    },
    {
      "name": "Chat",
      "item": [
        { "name": "Ask about notes", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"message\": \"What is a stack?\",\n  \"noteSetIds\": [\"{{noteSetId}}\"],\n  \"language\": \"en\"\n}" }, "url": "{{baseUrl}}/api/v1/chat" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('chatSessionId', pm.response.json().data.sessionId);"] } }] },
        { "name": "Chat history", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/chat/history?sessionId={{chatSessionId}}&page=1&limit=20" } },
        { "name": "Delete chat session", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/chat/sessions/{{chatSessionId}}" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "List users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/admin/users?page=1&limit=20" } },
        { "name": "Update user role/status", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" }, "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}" } },
        { "name": "List prebuilt notes", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/admin/notes" } },
        { "name": "Create prebuilt note", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Stacks\",\n  \"text\": \"A stack is a last in, first out data structure.\",\n  \"language\": \"en\",\n  \"level\": \"beginner\"\n}" }, "url": "{{baseUrl}}/api/v1/admin/notes" } },
        { "name": "Flagged chat answers", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/admin/chat/flagged" } },
        { "name": "Analytics", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/admin/stats" } },
        { "name": "Export sessions CSV", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/admin/export/sessions.csv" } }
      ]
    }
  ]
}
