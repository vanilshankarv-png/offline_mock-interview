CLIENT_ORIGIN=http://localhost:5173
INTERNAL_KEY=replace-this-with-a-long-random-key
JWT_ACCESS_SECRET=replace-this-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-this-with-another-32-character-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChooseASecret123
DEMO_PASSWORD=DemoPassword123
SERVER_PORT=5000
# Optional model/rewrite settings
